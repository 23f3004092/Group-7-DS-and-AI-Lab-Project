# =============================================================================
# AgriAssist — .gitignore
# =============================================================================

# ----------------------------- Data & Storage --------------------------------
# Large datasets, processed CSVs, and image dumps must NOT be committed to Git.
# Only data/sample/ and data/README.md are tracked (`docs/instructor_feedback/on_repo_structure.md`).
data/raw/
data/processed/
data/final/
data/Vision_dataset/
data/eval/

outputs/Yeild_output_files/*
outputs/generation/best_adapter
outputs/ieg_model/
outputs/ieg_final/
outputs/ieg*/
outputs/output_files/*
outputs/yield_kernel_output/
docs/internal/do_not_open/requiredforgcp/artifacts/
storage/

# Ensure sample verification directory and dataset documentation stay tracked
!data/sample/
!data/README.md

# ----------------------------- Python ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
download_k*
# ----------------------------- Jupyter / IPython -----------------------------
.ipynb_checkpoints/
*.ipynb_metadata/

# ----------------------------- IDE / Editors ---------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----------------------------- OS --------------------------------------------
desktop.ini
*.lnk

# ----------------------------- Model Artifacts -------------------------------
# Large model checkpoints — store on HuggingFace Hub or Google Drive
*.pt
*.pth
*.ckpt
*.h5
*.safetensors
*.bin

# ----------------------------- Misc ------------------------------------------
*.log
*.env
.env.*
